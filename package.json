{
  "name": "@francozanardi/sbx",
  "version": "0.1.0",
  "description": "Named local sandboxes of a repository: one clone, one port block, one set of services and seeded data each.",
  "keywords": [
    "sandbox",
    "git-clone",
    "parallel",
    "agents",
    "development-environment",
    "docker-compose",
    "cli"
  ],
  "license": "MIT",
  "author": "Franco Zanardi",
  "homepage": "https://github.com/francozanardi/sbx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francozanardi/sbx.git"
  },
  "bugs": {
    "url": "https://github.com/francozanardi/sbx/issues"
  },
  "type": "module",
  "bin": {
    "sbx": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sbx": "tsx src/main.ts",
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && chmod +x dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.4"
  }
}
